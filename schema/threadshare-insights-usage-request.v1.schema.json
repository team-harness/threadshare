{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadshare.team-harness.com/schema/threadshare-insights-usage-request.v1.schema.json",
  "title": "Threadshare Insights Usage Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "window", "orderBy"],
  "properties": {
    "format": { "const": "threadshare-insights-usage-request@v1" },
    "window": { "$ref": "#/$defs/window" },
    "comparisonWindow": { "$ref": "#/$defs/window" },
    "filters": { "$ref": "#/$defs/filters" },
    "orderBy": {
      "enum": [
        "recorded-invocation-count",
        "recorded-failing-invocation-count",
        "distinct-turn-count",
        "distinct-session-count",
        "distinct-dedupe-group-count",
        "last-used",
        "absolute-recorded-invocation-change"
      ]
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
    "cursor": { "type": "string", "minLength": 1, "maxLength": 32768 }
  },
  "$defs": {
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAtOrAfter", "observedBefore"],
      "properties": {
        "observedAtOrAfter": { "$ref": "#/$defs/timestamp" },
        "observedBefore": { "$ref": "#/$defs/timestamp" }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providers": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "projectKeys": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": { "$ref": "#/$defs/hex64" }
        },
        "closureStates": {
          "type": "array", "maxItems": 3, "uniqueItems": true,
          "items": { "enum": ["hard-sealed", "quiescent", "open"] }
        }
      }
    }
  }
}
