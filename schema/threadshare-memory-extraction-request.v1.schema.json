{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadshare.team-harness.com/schema/threadshare-memory-extraction-request.v1.schema.json",
  "title": "Threadshare Memory Extraction Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "window"],
  "properties": {
    "format": { "const": "threadshare-memory-extraction-request@v1" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "before"],
      "properties": {
        "after": { "$ref": "#/$defs/canonicalTimestamp" },
        "before": { "$ref": "#/$defs/canonicalTimestamp" }
      }
    },
    "query": { "type": "string", "maxLength": 8192 },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 2,
          "items": { "enum": ["claude", "codex"] }
        },
        "sessionKeys": { "$ref": "#/$defs/opaqueKeys" },
        "toolCapabilityKeys": { "$ref": "#/$defs/opaqueKeys" },
        "skillCapabilityKeys": { "$ref": "#/$defs/opaqueKeys" },
        "resultEvidence": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": { "enum": ["provider-completed", "abandoned", "unknown"] }
        },
        "capabilityTerminalStates": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 5,
          "items": { "enum": ["pending", "completed", "failed", "cancelled", "unknown"] }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["capabilityTerminalStates"],
            "properties": { "capabilityTerminalStates": { "type": "array", "minItems": 1 } }
          },
          "then": {
            "anyOf": [
              {
                "required": ["toolCapabilityKeys"],
                "properties": { "toolCapabilityKeys": { "type": "array", "minItems": 1 } }
              },
              {
                "required": ["skillCapabilityKeys"],
                "properties": { "skillCapabilityKeys": { "type": "array", "minItems": 1 } }
              }
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "canonicalTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "opaqueKeys": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    }
  }
}
