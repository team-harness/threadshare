{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadshare.team-harness.com/schema/threadshare-memory-consolidation-task.v1.schema.json",
  "title": "Threadshare Memory Consolidation Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "taskId", "lease", "binding", "entries", "scenes", "doctrine", "policy", "contract"],
  "properties": {
    "format": { "const": "threadshare-memory-consolidation-task@v1" },
    "taskId": { "$ref": "#/$defs/identifier" },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holder", "expiresAt"],
      "properties": {
        "holder": { "type": "string", "minLength": 1 },
        "expiresAt": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "binding": { "$ref": "#/$defs/consolidationBinding" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryId", "revision", "contentDigest", "type", "scene", "priority", "confidence", "body"],
        "properties": {
          "entryId": { "$ref": "#/$defs/identifier" },
          "revision": { "$ref": "#/$defs/positiveInteger" },
          "contentDigest": { "$ref": "#/$defs/hex64" },
          "type": { "enum": ["work_fact", "work_task", "work_method", "work_artifact"] },
          "scene": { "oneOf": [{ "$ref": "#/$defs/sceneName" }, { "type": "null" }] },
          "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
          "confidence": { "enum": ["high", "medium", "low"] },
          "body": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "contentDigest", "heat", "content"],
        "properties": {
          "name": { "$ref": "#/$defs/slug" },
          "contentDigest": { "$ref": "#/$defs/hex64" },
          "heat": { "$ref": "#/$defs/positiveInteger" },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "doctrine": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contentDigest", "content"],
          "properties": {
            "contentDigest": { "$ref": "#/$defs/hex64" },
            "content": { "type": "string", "minLength": 1 }
          }
        },
        { "type": "null" }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxScenes", "mergePreferredAt", "createForbiddenAt", "dueEntryCount", "heatAlgorithm"],
      "properties": {
        "maxScenes": { "const": 15 },
        "mergePreferredAt": { "const": 12 },
        "createForbiddenAt": { "const": 14 },
        "dueEntryCount": { "$ref": "#/$defs/positiveInteger" },
        "heatAlgorithm": { "const": "scene-heat@1" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patchSchema", "prompts"],
      "properties": {
        "patchSchema": { "const": "threadshare-memory-consolidation-patch@v1" },
        "prompts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["promptVersion", "consolidation"],
          "properties": {
            "promptVersion": { "type": "string", "minLength": 1 },
            "consolidation": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
    "sceneName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "nonNegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryKey", "worktreeKey"],
      "properties": {
        "repositoryKey": { "$ref": "#/$defs/hex64" },
        "worktreeKey": { "$ref": "#/$defs/hex64" }
      }
    },
    "consolidationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databaseUuid", "memoryStateUuid", "owner", "approvedProjection", "entrySetDigest", "entryRevisions", "sceneIndexDigest", "sceneRevisions", "doctrineDigest", "replay", "promptVersion", "schemaVersion", "policyVersion"],
      "properties": {
        "databaseUuid": { "type": "string", "minLength": 1 },
        "memoryStateUuid": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/owner" },
        "approvedProjection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "analyzerVersion", "coverage", "sourceTreeDigest"],
          "properties": {
            "generation": { "$ref": "#/$defs/nonNegativeInteger" },
            "analyzerVersion": { "type": "string", "minLength": 1 },
            "coverage": { "const": "complete" },
            "sourceTreeDigest": { "$ref": "#/$defs/hex64" }
          }
        },
        "entrySetDigest": { "$ref": "#/$defs/hex64" },
        "entryRevisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entryId", "revision", "contentDigest"],
            "properties": {
              "entryId": { "$ref": "#/$defs/identifier" },
              "revision": { "$ref": "#/$defs/positiveInteger" },
              "contentDigest": { "$ref": "#/$defs/hex64" }
            }
          }
        },
        "sceneIndexDigest": { "$ref": "#/$defs/hex64" },
        "sceneRevisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "contentDigest", "heat"],
            "properties": {
              "name": { "$ref": "#/$defs/slug" },
              "contentDigest": { "$ref": "#/$defs/hex64" },
              "heat": { "$ref": "#/$defs/positiveInteger" }
            }
          }
        },
        "doctrineDigest": { "oneOf": [{ "$ref": "#/$defs/hex64" }, { "type": "null" }] },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "afterSuccessfulRunId"],
          "properties": {
            "mode": { "enum": ["incremental", "full"] },
            "afterSuccessfulRunId": {
              "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
            }
          }
        },
        "promptVersion": { "type": "string", "minLength": 1 },
        "schemaVersion": { "const": "threadshare-memory-consolidation-task@v1" },
        "policyVersion": { "type": "string", "minLength": 1 }
      }
    }
  }
}
