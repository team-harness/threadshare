{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadshare.team-harness.com/schema/threadshare-insights-search-request.v1.schema.json",
  "title": "Threadshare Insights Search Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format"],
  "properties": {
    "format": { "const": "threadshare-insights-search-request@v1" },
    "query": { "type": "string", "maxLength": 8192 },
    "filters": { "$ref": "#/$defs/filters" },
    "orderBy": { "enum": ["relevance", "observed-desc"] },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
    "pathLimit": { "type": "integer", "minimum": 0, "maximum": 20 }
  },
  "$defs": {
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providers": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "projectKeys": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": { "$ref": "#/$defs/hex64" }
        },
        "toolCapabilityKeys": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": { "$ref": "#/$defs/hex64" }
        },
        "skillCapabilityKeys": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": { "$ref": "#/$defs/hex64" }
        },
        "observedAtOrAfter": { "$ref": "#/$defs/timestamp" },
        "observedBefore": { "$ref": "#/$defs/timestamp" },
        "resultEvidence": {
          "type": "array", "maxItems": 3, "uniqueItems": true,
          "items": { "enum": ["provider-completed", "abandoned", "unknown"] }
        },
        "closureStates": {
          "type": "array", "maxItems": 3, "uniqueItems": true,
          "items": { "enum": ["hard-sealed", "quiescent", "open"] }
        },
        "capabilityTerminalStates": {
          "type": "array", "maxItems": 5, "uniqueItems": true,
          "items": { "enum": ["pending", "completed", "failed", "cancelled", "unknown"] }
        }
      }
    }
  }
}
