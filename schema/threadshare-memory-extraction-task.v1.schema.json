{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadshare.team-harness.com/schema/threadshare-memory-extraction-task.v1.schema.json",
  "title": "Threadshare Memory Extraction Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "taskId", "lease", "binding", "session", "evidenceCatalog", "chunk", "context", "contract"],
  "properties": {
    "format": { "const": "threadshare-memory-extraction-task@v1" },
    "taskId": { "$ref": "#/$defs/identifier" },
    "lease": { "$ref": "#/$defs/lease" },
    "binding": { "$ref": "#/$defs/extractionBinding" },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "repositoryKey", "timeWindow"],
      "properties": {
        "project": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "repositoryKey": { "$ref": "#/$defs/hex64" },
        "timeWindow": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {
                "start": { "type": "string", "minLength": 1 },
                "end": { "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "evidenceCatalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "kind", "pointerDigest", "display"],
        "properties": {
          "evidenceId": { "$ref": "#/$defs/identifier" },
          "kind": { "enum": ["commit", "turn", "path"] },
          "pointerDigest": { "$ref": "#/$defs/hex64" },
          "display": { "type": "string", "minLength": 1 }
        }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnRange", "coverage", "transcript"],
      "properties": {
        "turnRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/nonNegativeInteger" },
            "end": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceKind", "ref", "completeness", "bytes"],
            "properties": {
              "sourceKind": { "enum": ["turn", "tool-payload"] },
              "ref": { "type": "string", "minLength": 1 },
              "completeness": { "enum": ["full", "truncated"] },
              "bytes": { "$ref": "#/$defs/nonNegativeInteger" }
            }
          }
        },
        "transcript": { "type": "string" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneIndexSummary"],
      "properties": {
        "sceneIndexSummary": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draftSchema", "prompts"],
      "properties": {
        "draftSchema": { "const": "threadshare-memory-candidate-draft-batch@v1" },
        "prompts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["promptVersion", "extraction"],
          "properties": {
            "promptVersion": { "type": "string", "minLength": 1 },
            "extraction": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "decimalString": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holder", "expiresAt"],
      "properties": {
        "holder": { "type": "string", "minLength": 1 },
        "expiresAt": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "extractionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databaseUuid", "owner", "sourceInputDigest", "turnRevisions", "payloadDigests", "deliveryEdgeRevisions", "promptVersion", "schemaVersion", "chunkerVersion", "provenance"],
      "properties": {
        "databaseUuid": { "type": "string", "minLength": 1 },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositoryKey", "worktreeKey"],
          "properties": {
            "repositoryKey": { "$ref": "#/$defs/hex64" },
            "worktreeKey": { "$ref": "#/$defs/hex64" }
          }
        },
        "sourceInputDigest": { "$ref": "#/$defs/hex64" },
        "turnRevisions": { "type": "array", "items": { "$ref": "#/$defs/hex64" } },
        "payloadDigests": { "type": "array", "items": { "$ref": "#/$defs/hex64" } },
        "deliveryEdgeRevisions": { "type": "array", "items": { "$ref": "#/$defs/hex64" } },
        "promptVersion": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "minLength": 1 },
        "chunkerVersion": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["snapshotSeq", "evaluatedAt"],
          "properties": {
            "snapshotSeq": { "$ref": "#/$defs/decimalString" },
            "evaluatedAt": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
