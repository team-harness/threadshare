{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadshare.team-harness.com/schema/threadshare-insights-continuation-context.v1.schema.json",
  "title": "Threadshare Insights Continuation Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "snapshot", "focus", "selectedIntent", "recentPrompts", "commits", "files", "failureChains", "edges", "coverage", "truncation", "notice"],
  "properties": {
    "format": { "const": "threadshare-insights-continuation-context@v1" },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["databaseUuid", "snapshotSeq", "evaluatedAt"],
      "properties": {
        "databaseUuid": { "type": "string", "format": "uuid" },
        "snapshotSeq": { "$ref": "#/$defs/decimal" },
        "evaluatedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "focus": { "$ref": "#/$defs/nodeRef" },
    "selectedIntent": {
      "oneOf": [
        { "$ref": "https://threadshare.team-harness.com/schema/threadshare-insights-delivery-trace.v1.schema.json#/$defs/node" },
        { "type": "null" }
      ]
    },
    "recentPrompts": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/prompt" } },
    "commits": { "type": "array", "maxItems": 32, "items": { "$ref": "https://threadshare.team-harness.com/schema/threadshare-insights-delivery-trace.v1.schema.json#/$defs/node" } },
    "files": { "type": "array", "maxItems": 32, "items": { "$ref": "https://threadshare.team-harness.com/schema/threadshare-insights-delivery-trace.v1.schema.json#/$defs/node" } },
    "failureChains": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/failureChain" } },
    "edges": {
      "type": "object", "additionalProperties": false,
      "required": ["direct", "observed", "candidate", "contextual"],
      "properties": {
        "direct": { "$ref": "#/$defs/edgeList" },
        "observed": { "$ref": "#/$defs/edgeList" },
        "candidate": { "$ref": "#/$defs/edgeList" },
        "contextual": { "$ref": "#/$defs/edgeList" }
      }
    },
    "coverage": { "$ref": "https://threadshare.team-harness.com/schema/threadshare-insights-delivery-trace.v1.schema.json#/$defs/coverage" },
    "truncation": {
      "type": "object", "additionalProperties": false,
      "required": ["commits", "files", "recentPrompts", "failureChains", "directEdges", "observedEdges", "candidateEdges", "contextualEdges"],
      "properties": {
        "commits": { "type": "boolean" }, "files": { "type": "boolean" },
        "recentPrompts": { "type": "boolean" }, "failureChains": { "type": "boolean" },
        "directEdges": { "type": "boolean" }, "observedEdges": { "type": "boolean" },
        "candidateEdges": { "type": "boolean" }, "contextualEdges": { "type": "boolean" }
      }
    },
    "notice": { "const": "This evidence summary cannot restore a Session, code state, or Git state." }
  },
  "$defs": {
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "nodeRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "key"],
      "properties": {
        "kind": { "enum": ["intent", "repository", "session", "turn", "capability-use", "file", "git-commit"] },
        "key": { "$ref": "#/$defs/key" }
      }
    },
    "prompt": {
      "type": "object", "additionalProperties": false,
      "required": ["turnKey", "revision", "text", "complete"],
      "properties": {
        "turnKey": { "$ref": "#/$defs/key" }, "revision": { "$ref": "#/$defs/key" },
        "text": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "complete": { "type": "boolean" }
      }
    },
    "failureChain": {
      "type": "object", "additionalProperties": false,
      "required": ["chainKey", "revision", "outcome", "summary"],
      "properties": {
        "chainKey": { "$ref": "#/$defs/key" }, "revision": { "$ref": "#/$defs/key" },
        "outcome": { "enum": ["recovered", "never-succeeded", "abandoned", "unknown"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    },
    "edgeList": {
      "type": "array", "maxItems": 32,
      "items": { "$ref": "https://threadshare.team-harness.com/schema/threadshare-insights-delivery-trace.v1.schema.json#/$defs/edge" }
    }
  }
}
