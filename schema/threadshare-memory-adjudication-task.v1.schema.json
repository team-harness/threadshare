{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadshare.team-harness.com/schema/threadshare-memory-adjudication-task.v1.schema.json",
  "title": "Threadshare Memory Adjudication Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "taskId", "lease", "binding", "drafts", "recallSets", "pool", "contract"],
  "properties": {
    "format": { "const": "threadshare-memory-adjudication-task@v1" },
    "taskId": { "$ref": "#/$defs/identifier" },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holder", "expiresAt"],
      "properties": {
        "holder": { "type": "string", "minLength": 1 },
        "expiresAt": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "binding": { "$ref": "#/$defs/adjudicationBinding" },
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "content", "type", "priority", "confidence", "scene", "statements"],
        "properties": {
          "candidateId": { "$ref": "#/$defs/identifier" },
          "content": { "type": "string", "minLength": 1 },
          "type": { "enum": ["work_fact", "work_task", "work_method", "work_artifact"] },
          "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
          "confidence": { "enum": ["high", "medium", "low"] },
          "scene": { "oneOf": [{ "$ref": "#/$defs/sceneName" }, { "type": "null" }] },
          "statements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["statementId", "text", "evidenceIds"],
              "properties": {
                "statementId": { "$ref": "#/$defs/identifier" },
                "text": { "type": "string", "minLength": 1 },
                "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
              }
            }
          }
        }
      }
    },
    "recallSets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["draftRef", "ordered"],
        "properties": {
          "draftRef": { "$ref": "#/$defs/identifier" },
          "ordered": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rank", "sourceKind", "id"],
              "properties": {
                "rank": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "sourceKind": { "enum": ["approved", "candidate"] },
                "id": { "$ref": "#/$defs/identifier" }
              }
            }
          }
        }
      }
    },
    "pool": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceKind", "id", "revision", "contentDigest", "state", "summary"],
        "properties": {
          "sourceKind": { "enum": ["approved", "candidate"] },
          "id": { "$ref": "#/$defs/identifier" },
          "revision": { "$ref": "#/$defs/nonNegativeInteger" },
          "contentDigest": { "$ref": "#/$defs/hex64" },
          "state": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultSchema", "prompts"],
      "properties": {
        "resultSchema": { "const": "threadshare-memory-adjudication-result@v1" },
        "prompts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["promptVersion", "adjudication"],
          "properties": {
            "promptVersion": { "type": "string", "minLength": 1 },
            "adjudication": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sceneName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "nonNegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "adjudicationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databaseUuid", "memoryStateUuid", "owner", "draftBatchDigest", "approvedProjection", "candidateProjection", "recallAlgorithmVersion", "recallQueryDigest", "resultSetDigest", "poolItemRevisions", "promptVersion", "schemaVersion"],
      "properties": {
        "databaseUuid": { "type": "string", "minLength": 1 },
        "memoryStateUuid": { "type": "string", "minLength": 1 },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositoryKey", "worktreeKey"],
          "properties": {
            "repositoryKey": { "$ref": "#/$defs/hex64" },
            "worktreeKey": { "$ref": "#/$defs/hex64" }
          }
        },
        "draftBatchDigest": { "$ref": "#/$defs/hex64" },
        "approvedProjection": { "$ref": "#/$defs/projection" },
        "candidateProjection": { "$ref": "#/$defs/projection" },
        "recallAlgorithmVersion": { "type": "string", "minLength": 1 },
        "recallQueryDigest": { "$ref": "#/$defs/hex64" },
        "resultSetDigest": { "$ref": "#/$defs/hex64" },
        "poolItemRevisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceKind", "id", "revision"],
            "properties": {
              "sourceKind": { "enum": ["approved", "candidate"] },
              "id": { "$ref": "#/$defs/identifier" },
              "revision": { "$ref": "#/$defs/nonNegativeInteger" }
            }
          }
        },
        "promptVersion": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "minLength": 1 }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "analyzerVersion"],
      "properties": {
        "generation": { "$ref": "#/$defs/nonNegativeInteger" },
        "analyzerVersion": { "type": "string", "minLength": 1 }
      }
    }
  }
}
