{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadshare.team-harness.com/schema/threadshare-memory-adjudication-result.v1.schema.json",
  "title": "Threadshare Memory Adjudication Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "taskId", "binding", "adjudications"],
  "properties": {
    "format": { "const": "threadshare-memory-adjudication-result@v1" },
    "taskId": { "$ref": "#/$defs/identifier" },
    "binding": { "$ref": "#/$defs/adjudicationBinding" },
    "adjudications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["draftRef", "action", "targetIds", "mergedFields"],
        "properties": {
          "draftRef": { "$ref": "#/$defs/identifier" },
          "action": { "enum": ["store", "skip", "update", "merge"] },
          "targetIds": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
          "mergedFields": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "content": { "type": "string", "minLength": 1 },
                  "type": { "enum": ["work_fact", "work_task", "work_method", "work_artifact"] },
                  "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
                  "scene": { "oneOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }] },
                  "occurred": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                }
              },
              { "type": "null" }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "adjudicationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databaseUuid", "memoryStateUuid", "owner", "draftBatchDigest", "approvedProjection", "candidateProjection", "recallAlgorithmVersion", "recallQueryDigest", "resultSetDigest", "poolItemRevisions", "promptVersion", "schemaVersion"],
      "properties": {
        "databaseUuid": { "type": "string", "minLength": 1 },
        "memoryStateUuid": { "type": "string", "minLength": 1 },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositoryKey", "worktreeKey"],
          "properties": {
            "repositoryKey": { "$ref": "#/$defs/hex64" },
            "worktreeKey": { "$ref": "#/$defs/hex64" }
          }
        },
        "draftBatchDigest": { "$ref": "#/$defs/hex64" },
        "approvedProjection": { "$ref": "#/$defs/projection" },
        "candidateProjection": { "$ref": "#/$defs/projection" },
        "recallAlgorithmVersion": { "type": "string", "minLength": 1 },
        "recallQueryDigest": { "$ref": "#/$defs/hex64" },
        "resultSetDigest": { "$ref": "#/$defs/hex64" },
        "poolItemRevisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceKind", "id", "revision"],
            "properties": {
              "sourceKind": { "enum": ["approved", "candidate"] },
              "id": { "$ref": "#/$defs/identifier" },
              "revision": { "$ref": "#/$defs/nonNegativeInteger" }
            }
          }
        },
        "promptVersion": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "minLength": 1 }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "analyzerVersion"],
      "properties": {
        "generation": { "$ref": "#/$defs/nonNegativeInteger" },
        "analyzerVersion": { "type": "string", "minLength": 1 }
      }
    }
  }
}
