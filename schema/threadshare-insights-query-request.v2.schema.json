{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadshare.team-harness.com/schema/threadshare-insights-query-request.v2.schema.json",
  "title": "Threadshare Insights Query Request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "resource", "shape", "orderBy", "limit"],
  "properties": {
    "format": { "const": "threadshare-insights-query-request@v2" },
    "resource": { "enum": ["session", "turn", "event", "capability-use", "file-activity", "token-usage", "error-occurrence"] },
    "where": { "oneOf": [{ "$ref": "#/$defs/predicate" }, { "type": "null" }] },
    "shape": { "$ref": "#/$defs/shape" },
    "orderBy": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/order" } },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
    "cursor": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 32768 }, { "type": "null" }] },
    "count": { "enum": ["none", "exact"] }
  },
  "$defs": {
    "order": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "direction"],
      "properties": { "field": { "type": "string", "minLength": 1, "maxLength": 256 }, "direction": { "enum": ["asc", "desc"] } }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "op"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "op": { "enum": ["count", "distinct-count", "sum", "min", "max", "average"] },
        "field": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "shape": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "select"],
          "properties": {
            "kind": { "const": "records" },
            "select": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
            "payloadMode": { "enum": ["omit", "reference", "inline"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "groupBy", "metrics"],
          "properties": {
            "kind": { "const": "aggregate" },
            "groupBy": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
            "metrics": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/metric" } }
          }
        }
      ]
    },
    "predicate": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["and"], "properties": { "and": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/predicate" } } } },
        { "type": "object", "additionalProperties": false, "required": ["or"], "properties": { "or": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/predicate" } } } },
        { "type": "object", "additionalProperties": false, "required": ["not"], "properties": { "not": { "$ref": "#/$defs/predicate" } } },
        {
          "type": "object", "additionalProperties": false, "required": ["field", "op"],
          "properties": {
            "field": { "type": "string", "minLength": 1, "maxLength": 256 },
            "op": { "enum": ["eq", "ne", "in", "not-in", "exists", "lt", "lte", "gt", "gte", "between", "prefix", "contains", "match"] },
            "value": { "oneOf": [{ "type": "string", "maxLength": 8192 }, { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "maxLength": 8192 } }] }
          }
        }
      ]
    }
  }
}
