{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadshare.team-harness.com/schema/threadshare-insights-agent-spec.v1.schema.json",
  "title": "Threadshare Insights Agent Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "purpose", "userContract", "startup", "intents", "actions", "schemas"],
  "properties": {
    "format": { "const": "threadshare-insights-agent-spec@v1" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 512 },
    "userContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userProvidesNaturalLanguageQuestion", "agentChoosesProtocol", "maintenanceNeverImplicit"],
      "properties": {
        "userProvidesNaturalLanguageQuestion": { "const": true },
        "agentChoosesProtocol": { "const": true },
        "maintenanceNeverImplicit": { "const": true }
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspect", "refresh", "rule"],
      "properties": {
        "inspect": { "type": "string", "minLength": 1, "maxLength": 256 },
        "refresh": { "type": "string", "minLength": 1, "maxLength": 256 },
        "rule": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "intents": {
      "type": "array",
      "minItems": 8,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/intent" }
    },
    "actions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/action" }
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^schema/[a-z0-9.-]+\\.schema\\.json$" }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "purpose", "requiredInputs", "optionalFilters"],
      "properties": {
        "action": { "enum": ["overview", "capabilities", "usage", "activity", "search", "query", "recipe", "evidence"] },
        "target": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recipe": {
          "enum": [
            "capability-contexts@1",
            "failure-chains@1",
            "file-workflow-signals@1",
            "activity-shifts@1",
            "token-hotspots@1",
            "solution-recall@1",
            "session-timeline@1"
          ]
        },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 512 },
        "requiredInputs": { "$ref": "#/$defs/stringList" },
        "optionalFilters": { "$ref": "#/$defs/stringList" }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "userQuestions", "plan", "answerRules"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$", "maxLength": 64 },
        "when": { "type": "string", "minLength": 1, "maxLength": 512 },
        "userQuestions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "plan": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/step" }
        },
        "answerRules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "useWhen", "help", "requestFormat"],
      "properties": {
        "action": { "enum": ["overview", "capabilities", "usage", "activity", "search", "query", "recipe", "evidence"] },
        "useWhen": { "type": "string", "minLength": 1, "maxLength": 512 },
        "help": { "type": "string", "pattern": "^threadshare insights ", "maxLength": 256 },
        "requestFormat": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^threadshare-insights-[a-z-]+@v[0-9]+$",
              "maxLength": 128
            },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
